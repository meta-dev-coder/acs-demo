node_modules/
dist/
# Local env files hold the DataConnect credentials (DC_USERNAME / DC_PASSWORD); never commit them.
.env
.env.local
.env.*.local
test-results/
playwright-report/
.playwright/

# Corridor GLB models: ~100 MB, well past GitHub's 50 MB advisory, and only needed to render the
# toll-gantry and lane-barrier layers. Kept locally; config/cesiumModels.json still points at them,
# so a clone without the files lists those layers and logs the URL it could not load.
public/models/i595/*.glb

# The rotated DataConnect refresh token (server-side credential).
.dc-refresh-token
.dc-access-token

# State files of the former local DataConnect stand-in (now a test double only).
.dc-standin/

# EC2 live-dc bundle (npm run live-dc:bundle)
deploy/ec2/dist/
deploy/ec2/releases/

# Ask the Twin local store (npm run twin:store) and recorded model responses
.twin-store/

# Local state for the Construction Integration Demo (SQLite). Generated, never committed.
.data/

# Phase 9A — the Speckle verification tool is Python. The venv is a 40 MB build artefact (pyarrow
# alone is 37 MB) and the report is generated output that names the account that ran it, so
# neither belongs in the repository. The script, its pins and its README do.
tools/speckle/.venv/
tools/speckle/verification-report.json
__pycache__/
*.pyc

# Phase 9B — converted Speckle artifacts. Regenerated from Speckle on demand and cached by
# immutable version id, so they are build output, not source. A committed copy of one model lives
# in tests/fixtures/speckle/ as a test fixture and IS tracked.
.data/speckle/

# Encrypted APS session store (server/aps/sessions.mjs), only written with APS_SESSION_ENCRYPTION_KEY set
.aps/
