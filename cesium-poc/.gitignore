node_modules/
dist/
# Local env files hold the DataConnect credentials (DC_USERNAME / DC_PASSWORD); never commit them.
.env
.env.local
.env.*.local
test-results/
playwright-report/
.playwright/

# Corridor GLB models: ~100 MB, well past GitHub's 50 MB advisory, and only needed to render the
# toll-gantry and lane-barrier layers. Kept locally; config/cesiumModels.json still points at them,
# so a clone without the files lists those layers and logs the URL it could not load.
public/models/i595/*.glb

# The rotated DataConnect refresh token (server-side credential).
.dc-refresh-token
.dc-access-token

# State files of the former local DataConnect stand-in (now a test double only).
.dc-standin/
