# Optional. With a Cesium ion token the app uses Cesium World Terrain (and you can later swap in
# Google Photorealistic 3D Tiles). WITHOUT a token it falls back to OpenStreetMap imagery on a flat
# ellipsoid — still renders the real I-595 location, just not 3D terrain. Get a token at
# https://ion.cesium.com/tokens   then:  cp .env.example .env  and fill this in.
VITE_CESIUM_ION_TOKEN=

# Set to false to hide all Street View controls (toolbar, placement, and camera detail buttons).
    VITE_ENABLE_STREET_VIEW=true

# ---- FL511 live road events (server side only) --------------------------------------------------
# The browser never calls FL511. `npm start` mounts the live-event API inside Vite at
# /api/i595/live-events; a static deployment runs the same handler with `npm run api` instead.
# These endpoints are publicly reachable but undocumented parts of FL511's own website, so every
# URL is overridable here rather than hard-coded, and polling stays gentle.
# FL511_BASE_URL=https://fl511.com
# FL511_INCIDENTS_PATH=/map/mapIcons/Incidents
# FL511_CLOSURES_PATH=/map/mapIcons/Closures
# Detail fragment, declared by FL511's own map markup as data-tooltipbaseurl:
# FL511_DETAIL_PATH=/tooltip/{layerId}/{id}?lang={lang}
# Live-event polling is fixed at 60 seconds.
# FL511_TIMEOUT_MS=10000            # per-request timeout
# FL511_RETRY_ATTEMPTS=2            # attempts per poll (a 4xx stops retrying immediately)
# Live-event detail cache lifetime is 60 seconds.
# FL511_STALE_AFTER_SECONDS=180     # cached data older than this is served but labelled STALE
# I595_LIVE_EVENT_BUFFER_METERS=250 # corridor relevance: distance to the real I-595 network
# I595_LIVE_EVENT_SEGMENT_TOLERANCE_METERS=120  # max distance to claim an FDOT traffic section
# FL511_API_PORT=5189               # standalone `npm run api` port

# Optional frontend overrides, only needed when the API is not same-origin:
# VITE_LIVE_EVENTS_API=/api/i595/live-events
# Live-event browser polling is fixed at 60 seconds.

# ---- Google Photorealistic 3D Tiles (optional base environment) ----------------------------------
# Map explorer → Map → Base Environment → "Google Photorealistic 3D". Without this key the option
# is still shown but reports that the key is missing and stays on the satellite basemap; no request
# is made to Google. Never commit a real key — .env is gitignored, .env.example is not.
#
# Google Cloud project requirements:
#   1. billing enabled on the project
#   2. "Map Tiles API" enabled
#   3. an API key created for that project
#   4. the key restricted (see below)
#
# This value is compiled into the browser bundle, like every VITE_ variable, so it cannot be kept
# secret. Its security comes entirely from Google-side restrictions:
#   - Application restriction: HTTP referrers, listing only this app's domains
#     (e.g. http://localhost:5188/*, https://<your-pages-domain>/acs-demo/twin/*)
#   - API restriction: "Map Tiles API" and "Street View Static API" only
#   - separate keys for development and production, so one can be rotated without the other
#
#   Street View reuses this same key — it is not configured separately. Cesium's
#   GoogleStreetViewCubeMapPanoramaProvider reads GoogleMaps.defaultApiKey, which the
#   photorealistic tileset sets from this variable.
#
#   Google APIs this application actually uses:
#     - Map Tiles API          Photorealistic 3D Tiles (the base environment)
#     - Street View Static API panorama metadata lookup and cube-map faces
#   Nothing else is required — in particular the Maps JavaScript API is NOT used,
#   and no Google SDK is loaded in the browser.
#
#   Both are billable Google Maps Platform services. Panorama metadata lookups are
#   free of charge; loading a panorama's imagery is billed per request. Street View
#   is only ever contacted when a user opens it, never during start-up.
VITE_GOOGLE_MAPS_API_KEY=

# ---- Corridor GLB models ------------------------------------------------------------------------
# Where the toll-gantry and lane-barrier meshes are hosted. Records in config/cesiumModels.json name
# only their object key, so moving the models is this one value rather than an edit to each record.
# Served through the CloudFront distribution that already fronts the data bucket, so the browser
# needs no AWS credentials — these are public GETs of public objects.
VITE_I595_MODEL_BASE_URL=https://d3syo4sqvwi009.cloudfront.net/data/models

# Development tool. Draws clipping polygons against the live scene so the coordinates that hide
# Google's own photogrammetry are traced rather than guessed. Off unless set to exactly "true";
# leave it unset for anything a normal user opens.
VITE_ENABLE_CESIUM_CLIP_EDITOR=

# ---- DataConnect ---------------------------------------------------------------------------------
# Read by the dev/preview server only (server/dataConnect.mjs). These names are deliberately NOT
# prefixed VITE_: a VITE_ variable is compiled into the public browser bundle, so a password in one
# would ship to every visitor. Put real values in .env.local, which git ignores.
#
# THIS FILE IS COMMITTED. Never put a real password or client id here — copy the block below into
# .env.local (git-ignored) and fill it in there.
#
# DC_BASE_URL=https://<your-dataconnect-host>
#
# Preferred — a SERVICE client (client_credentials). An application identity, no user password
# anywhere. This is what a server should use:
# DC_CLIENT_ID=<service client id>
# DC_CLIENT_SECRET=<service client secret>
#
# Fallback — a user password (ROPC). Only for an instance that still permits it. Bentley IMS
# refuses this for SPA/native clients (id starting "spa-") with `unauthorized_client`, no matter
# what credentials you send — that is a client-registration limit, not a wrong password:
# DC_CLIENT_ID=<oauth client id>
# DC_USERNAME=<user account>
# DC_PASSWORD=<password>
#
# The grant is chosen from what you set above; force it only if that guess is wrong:
# DC_GRANT=client_credentials          # or: password
# DC_SCOPE=itwin-platform              # whatever scope DataConnect requires
# DC_TOKEN_URL=https://ims.bentley.com/connect/token
# Optional overrides if the instance moves its paths:
# DC_CLASSES_PATH=/api/v1/class
# DC_CURATED_DATA_PATH=/api/v1/class/{classId}/curated-data
#
# Run from the cesium-poc directory, not the repo root:
# Then:  npm run dc:classes            # lists class ids and names (no token is printed)
#        VITE_DATA_SOURCE=dataconnect  # makes DataConnect the app's source (default today: mock)
# Class ids are discovered from the API by name; pin one only if a name is ambiguous:
# VITE_DC_CLASS_WORK_ORDERS=<class id>

# ---- Live DataConnect writer (FL511 -> SDNA Florida I595 Live classes) -------------------------------
# `npm run live-dc:sync` polls FL511 and writes corridor events, plus the incident workflow derived
# from them (tickets, tasks, work orders, inspections, asset status), into the six
# "SDNA Florida I595 Live *" classes ONLY. Historical Florida I595 classes are never written: the writer
# refuses them by name, by ObjectId and by numeric classId, and sends Incremental loads only.
# Operator doc: server/liveDc/README.md.
#
# The SPA / read-proxy token above (DC_*) is READ-ONLY (dce-read, dcm-read). Real writes need a
# separate Bentley SERVICE client with the dcm-admin role, configured here, never in a VITE_ variable.
#
# DataConnect is the only target: there is no default and no local stand-in. live-dc:sync exits 2
# when DC_WRITER_BASE_URL, DC_WRITER_LOAD_BASE_URL or a credential is missing. Every write guard still
# applies (Live-class allowlist, Incremental only, deletion only through the confirmed Live-only reset,
# never purge-all or load groups).
#
# Class metadata and curated reads use the data-management API: either the gateway with the default
# prefix, or the data-management host directly with DC_WRITER_DATA_MGMT_PREFIX=/api/v1.
# DC_WRITER_BASE_URL=https://dataconnect-demo-dqa3.cohesivecloud.app   # required
# DC_WRITER_DATA_MGMT_PREFIX=/api/data-mgmt/v1
# Records are written through the load service (/v1/loads register -> upload json-file -> process ->
# poll). The gateway's /api/loads/class is WAF-blocked for API clients and is no longer used.
# DC_WRITER_LOAD_BASE_URL=https://dc-load-demo-dqa3.cohesivecloud.app  # required
# Credentials (put real values in .env.local only), first match wins: a bearer token ...
# DC_WRITER_ACCESS_TOKEN=
# ... a token file, re-read on every request (`npm run dc:login` rewrites it about hourly) ...
# DC_WRITER_ACCESS_TOKEN_FILE=.dc-access-token
# ... or a service client:
# DC_WRITER_CLIENT_ID=<dcm-admin service client id>
# DC_WRITER_CLIENT_SECRET=<service client secret>
# DC_WRITER_SCOPE=itwin-platform
# DC_WRITER_TOKEN_URL=https://ims.bentley.com/connect/token
# Tuning (milliseconds unless stated):
# DC_WRITER_TIMEOUT_MS=30000                # per HTTP request
# DC_WRITER_POLL_INTERVAL_MS=1000           # load status / curation polling
# DC_WRITER_PROCESS_TIMEOUT_MS=120000       # wait for a load to finish processing
# DC_WRITER_CURATION_TIMEOUT_MS=120000      # wait for curation; a timeout defers dependent classes
# DC_WRITER_PAGE_SIZE=500                   # curated-data read page size (records)
#
# Sync runner (tools/live-dc-sync.mjs):
# LIVE_DC_PROFILE=demo                      # workflow timings: demo (minutes) | realistic (hours/days)
# LIVE_DC_SPAWN_TYPES=INCIDENT,DISABLED     # FL511 event types that open a ticket chain
# LIVE_DC_HEARTBEAT_SECONDS=900             # re-send an unchanged active event this often (0 = never); the API reads it too: DataConnect live events go STALE after heartbeat + 300 s (never when 0)
# LIVE_DC_ASSET_REFRESH_SECONDS=3600        # how long the Florida I595 Assets read is cached
# LIVE_DC_INTERVAL_SECONDS=60               # time between cycles (cycles never overlap)
# LIVE_DC_LINK_MODE=live                    # live | linked | none — must match how the admin created the classes
#
# Live DataConnect read view (Maintenance workspace; server/liveDc/liveReadApi.mjs at /api/live-dc).
# VITE_LIVE_DC=true                          # show Live records; default on in dev or with the dataconnect source; ?live=1 / ?live=0 per session
# Unset LIVE_DC_READ_BASE_URL = not configured: /api/live-dc answers 503, ?source=dataconnect answers
# UNAVAILABLE (never direct FL511), and the strips show "⚠ DataConnect not connected".
# LIVE_DC_READ_BASE_URL=https://dataconnect-demo-dqa3.cohesivecloud.app
# LIVE_DC_READ_DATA_MGMT_PREFIX=/api/data-mgmt/v1
# Read credential (put real values in .env.local only), first match wins:
# LIVE_DC_READ_ACCESS_TOKEN=
# LIVE_DC_READ_ACCESS_TOKEN_FILE=.dc-access-token   # re-read on every call
# LIVE_DC_READ_CLIENT_ID=
# LIVE_DC_READ_CLIENT_SECRET=
# LIVE_DC_READ_TIMEOUT_MS=15000
