# /etc/live-dc/env (root:livedc 640). Non-secret settings only: the DataConnect service client is read
# at startup from Secrets Manager through the instance role (LIVE_DC_SERVICE_CLIENT_SECRET_NAME) and also
# used, in-process, by the read proxies (LIVE_DC_READ_*, DC_*).
DC_WRITER_BASE_URL=https://dataconnect-demo-dqa3.cohesivecloud.app
DC_WRITER_LOAD_BASE_URL=https://dc-load-demo-dqa3.cohesivecloud.app
LIVE_DC_SERVICE_CLIENT_SECRET_NAME=i595/dataconnect/service-client
LIVE_DC_AWS_REGION=us-east-1
LIVE_DC_LINK_MODE=live
LIVE_DC_SPAWN_TYPES=INCIDENT,CLOSURE,CONSTRUCTION,CONGESTION,DISABLED
# Comma list of Live Events keys kept active when FL511 no longer lists them.
LIVE_DC_HOLD_OPEN=
LIVE_DC_INTERVAL_SECONDS=300
# Camera snapshots via `aws s3 cp` (instance role). Leave the bucket empty to turn snapshots off.
LIVE_DC_SNAPSHOT_BUCKET=i595stackv5-i595corridordata41064a5b-oixfpv0dyrzj
LIVE_DC_SNAPSHOT_PUBLIC_BASE=https://d3syo4sqvwi009.cloudfront.net
LIVE_DC_PUBLIC_API_BASE=https://d3syo4sqvwi009.cloudfront.net

# Demo host (frontend + read-only API) in the same process. Unset LIVE_DC_HTTP_PORT = sync only.
LIVE_DC_HTTP_HOST=0.0.0.0
LIVE_DC_HTTP_PORT=8095
# Required when the port is set. Generate on the instance (the password is read from the terminal, not echoed):
#   node /opt/live-dc/current/live-dc-sync.mjs --hash-password
LIVE_DEMO_PASSWORD_HASH=
# Free-form Ask the Twin (POST /api/i595/ask) via Claude. The key is read from this secret, JSON {"api_key"},
# through the instance role. Leave empty to keep free-form questions off (built-in answers still work).
ASK_TWIN_ANTHROPIC_SECRET_NAME=i595/anthropic-key
# ASK_TWIN_MODEL=claude-sonnet-5
# Phase 2 (ASK_THE_TWIN.md section 5): Ask the Twin in its own unit. Enable live-dc-ask.service, then set
# this so live-dc forwards /api/i595/ask to it after the session check.
# ASK_TWIN_SERVICE_URL=http://127.0.0.1:8787
# Optional: a second model for overloads, and a daily token budget (0/unset = no limit).
# ASK_TWIN_FALLBACK_MODEL=
# ASK_TWIN_DAILY_TOKENS=
# CloudFront edge path for GitHub Pages (ASK_THE_TWIN.md section 5.1): accepted x-ask-edge-key values.
# ASK_TWIN_EDGE_KEYS=
# Read proxies behind the gate: /api/live-dc + /api/i595/live-events?source=dataconnect, and /api/dataconnect.
LIVE_DC_READ_BASE_URL=https://dataconnect-demo-dqa3.cohesivecloud.app
DC_BASE_URL=https://dc-data-mgmt-demo-dqa3.cohesivecloud.app

# Releases for livedc.sh update (instance role: s3:GetObject on releases/live-dc/*).
LIVE_DC_RELEASE_BUCKET=i595stackv5-i595corridordata41064a5b-oixfpv0dyrzj
LIVE_DC_RELEASE_PREFIX=releases/live-dc
# Optional (defaults shown): LIVE_DC_PROFILE, LIVE_DC_HEARTBEAT_SECONDS=900, LIVE_DC_ASSET_REFRESH_SECONDS=3600,
# DC_WRITER_TOKEN_URL=https://ims.bentley.com/connect/token, DC_WRITER_SCOPE=itwin-platform, FL511_* (server/config.mjs).
