# Production build overrides. Vite loads .env in EVERY mode, including `npm run build`, so a local
# .env with development switches turned on would otherwise ship them. This file is loaded only for
# `vite build` and wins over .env, which keeps developer tooling out of the deployed bundle.
#
# Committed on purpose: it holds switches, never secrets. Keys stay in .env (gitignored) and, for
# CI, in the deploy workflow's environment.

# Clipping Polygon Editor / Model Placement Editor — developer tooling for tracing clipping
# polygons and aligning GLB models against the live scene. Empty = off in production.
# To use it locally: set VITE_ENABLE_CESIUM_CLIP_EDITOR=true in cesium-poc/.env and restart `npm run dev`.
VITE_ENABLE_CESIUM_CLIP_EDITOR=
